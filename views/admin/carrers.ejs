<!-- views/admin/carrers.ejs -->

<% layout("layouts/admin") %>

<main class="main-content">
  <div class="container-fluid">

    <!-- PAGE HEADER -->
    <h3 class="mb-4">
      <a href="/admin/academic">
        <i class="fa fa-book me-2"></i>
        Gestión Académica
      </a>
      / Carreras
    </h3>

    <div class="row">

      <!-- ========================= -->
      <!-- FORMULARIO -->
      <!-- ========================= -->
      <div class="col-lg-4 col-md-5 mb-4">

        <div class="card">

          <div class="card-header">
            <h6 class="mb-0" id="cardTitle">
              <i class="fa fa-plus me-2"></i>
              Nueva Carrera
            </h6>
          </div>

          <div class="card-body">

            <form method="POST" action="/carrers" id="carrerForm">

              <!-- ID de la carrera -->
              <input type="hidden" name="id" id="carrerID">

              <!-- NOMBRE -->
              <div class="mb-3">
                <label for="name" class="form-label">
                  Nombre
                </label>

                <input
                  type="text"
                  id="name"
                  name="name"
                  class="form-control"
                  placeholder="Ingrese el nombre de la carrera..."
                  required
                >
              </div>

              <!-- APELLIDO -->
              <div class="mb-3">
                <label for="lastname" class="form-label">
                  Apellido
                </label>

                <input
                  type="text"
                  id="lastname"
                  name="lastname"
                  class="form-control"
                  placeholder="Ingrese el apellido del estudiante..."
                  required
                >
              </div>

              <!-- CÓDIGO -->
              <div class="mb-3">
                <label for="code" class="form-label">
                  Código
                </label>

                <input
                  type="text"
                  id="code"
                  name="code"
                  class="form-control"
                  placeholder="Ingrese el código..."
                  required
                >
              </div>

              <!-- CICLO -->
              <div class="mb-3">
                <label for="cycle" class="form-label">
                  Ciclo
                </label>

                <input
                  type="text"
                  id="cycle"
                  name="cycle"
                  class="form-control"
                  placeholder="Ingrese el ciclo..."
                  required
                >
              </div>

              <!-- BOTONES -->
              <div class="d-flex justify-content-end gap-2">

                <button
                  type="button"
                  class="btn btn-outline-secondary"
                  onclick="limpiar()"
                >
                  <i class="fa fa-refresh me-1"></i>
                  Limpiar
                </button>

                <button
                  type="submit"
                  class="btn btn-success"
                  id="btnGuardar"
                >
                  <i class="fa fa-save me-1"></i>
                  Guardar
                </button>

              </div>

            </form>

          </div>
        </div>
      </div>


      <!-- ========================= -->
      <!-- LISTADO -->
      <!-- ========================= -->
      <div class="col-lg-8 col-md-7 mb-4">

        <div class="card">

          <div class="card-header">
            <h6 class="mb-0">
              <i class="fa fa-list me-2"></i>
              Lista de Carreras
            </h6>
          </div>

          <div class="card-body">

            <!-- HEADER ACTIONS -->
            <div class="d-flex justify-content-between align-items-center mb-3">

              <div class="text-muted">
                <i class="fa fa-graduation-cap me-1"></i>
                Carreras registradas
              </div>

              <div>
                <a
                  href="/carrers/new"
                  class="btn btn-success"
                >
                  <i class="fa fa-plus"></i>
                  Agregar Registro
                </a>
              </div>

            </div>


            <!-- TABLE -->
            <div class="table-responsive">

              <table class="table table-striped table-hover" id="carrers">

                <thead>
                  <tr>
                    <th>ID</th>
                    <th>Nombre</th>
                    <th>Apellido</th>
                    <th>Código</th>
                    <th>Ciclo</th>
                    <th class="text-end">Acciones</th>
                  </tr>
                </thead>

                <tbody>

                  <% if (carrers && carrers.length > 0) { %>

                    <% for (const carrer of carrers) { %>

                      <tr>

                        <!-- ID REAL DE LA BASE DE DATOS -->
                        <td>
                          <%= carrer.id %>
                        </td>

                        <td>
                          <%= carrer.name %>
                        </td>

                        <td>
                          <%= carrer.lastname %>
                        </td>

                        <td>
                          <%= carrer.code %>
                        </td>

                        <td>
                          <%= carrer.cycle %>
                        </td>

                        <td class="text-end">

                          <!-- EDITAR -->
                          <button
                            type="button"
                            class="btn btn-sm btn-outline-secondary me-1"
                            onclick="editar(<%= carrer.id %>, event)"
                          >
                            <i class="fa fa-edit"></i>
                            Editar
                          </button>

                          <!-- ELIMINAR -->
                          <button
                            type="button"
                            class="btn btn-sm btn-outline-danger"
                            onclick="eliminar(<%= carrer.id %>, event)"
                          >
                            <i class="fa fa-trash"></i>
                            Eliminar
                          </button>

                        </td>

                      </tr>

                    <% } %>

                  <% } else { %>

                    <tr>
                      <td colspan="6" class="text-center text-muted py-4">
                        No se encontraron carreras.
                      </td>
                    </tr>

                  <% } %>

                </tbody>

              </table>

            </div>

          </div>
        </div>

      </div>

    </div>

  </div>
</main>


<script>

  // ==========================================
  // LIMPIAR FORMULARIO
  // ==========================================

  function limpiar() {

    document.getElementById("carrerID").value = "";
    document.getElementById("name").value = "";
    document.getElementById("lastname").value = "";
    document.getElementById("code").value = "";
    document.getElementById("cycle").value = "";

    document.getElementById("cardTitle").innerHTML =
      '<i class="fa fa-plus me-2"></i>Nueva Carrera';

    document.getElementById("btnGuardar").innerHTML =
      '<i class="fa fa-save me-1"></i>Guardar';
  }


  // ==========================================
  // EDITAR CARRERA
  // ==========================================

  function editar(id, event) {

    event.preventDefault();

    let tr = event.currentTarget.closest("tr");

    let name = tr.children[1].innerText.trim();
    let lastname = tr.children[2].innerText.trim();
    let code = tr.children[3].innerText.trim();
    let cycle = tr.children[4].innerText.trim();

    // Colocar los datos en el formulario
    document.getElementById("carrerID").value = id;
    document.getElementById("name").value = name;
    document.getElementById("lastname").value = lastname;
    document.getElementById("code").value = code;
    document.getElementById("cycle").value = cycle;

    // Cambiar título
    document.getElementById("cardTitle").innerHTML =
      '<i class="fa fa-edit me-2"></i>Editar Carrera';

    // Cambiar texto del botón
    document.getElementById("btnGuardar").innerHTML =
      '<i class="fa fa-save me-1"></i>Actualizar';

    // Llevar al formulario
    document.getElementById("name").focus();

  }


  // ==========================================
  // ELIMINAR CARRERA
  // ==========================================

  function eliminar(id, event) {

    event.preventDefault();

    if (!confirm("¿Está seguro de eliminar esta carrera?")) {
      return;
    }

    let tr = event.currentTarget.closest("tr");

    tr.remove();

  }

</script> 