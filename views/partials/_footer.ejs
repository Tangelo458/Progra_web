<!-- views/partials/_footer.ejs -->

<footer class="bg-dark text-white mt-auto">

  <div class="container py-5">

    <div class="row g-4">


      <!-- =====================================================
           INFORMACIÓN
      ====================================================== -->
      <div class="col-12 col-md-6 col-lg-4">

        <div class="d-flex align-items-center mb-3">

          <i
            class="fa-solid fa-briefcase text-success fs-3 me-2">
          </i>

          <h5 class="mb-0 fw-bold">
            UniEmpleo
          </h5>

        </div>

        <p class="text-secondary mb-3">
          Plataforma de bolsa de trabajo universitaria
          que conecta a estudiantes con empresas y
          oportunidades profesionales.
        </p>

        <p class="text-secondary small mb-0">

          <i class="fa-solid fa-graduation-cap text-success me-2"></i>

          Impulsando el talento universitario.

        </p>

      </div>


      <!-- =====================================================
           NAVEGACIÓN
      ====================================================== -->
      <div class="col-6 col-md-3 col-lg-2">

        <h6 class="text-uppercase fw-bold mb-3">
          Navegación
        </h6>

        <ul class="list-unstyled">

          <li class="mb-2">

            <a
              href="/"
              class="text-secondary text-decoration-none">

              <i class="fa-solid fa-house me-2"></i>
              Inicio

            </a>

          </li>

          <li class="mb-2">

            <a
              href="/jobs"
              class="text-secondary text-decoration-none">

              <i class="fa-solid fa-briefcase me-2"></i>
              Ofertas

            </a>

          </li>

          <li class="mb-2">

            <a
              href="/companies"
              class="text-secondary text-decoration-none">

              <i class="fa-solid fa-building me-2"></i>
              Empresas

            </a>

          </li>

          <li class="mb-2">

            <a
              href="/how-it-works"
              class="text-secondary text-decoration-none">

              <i class="fa-solid fa-circle-question me-2"></i>
              ¿Cómo funciona?

            </a>

          </li>

        </ul>

      </div>


      <!-- =====================================================
           PARA ESTUDIANTES
      ====================================================== -->
      <div class="col-6 col-md-3 col-lg-3">

        <h6 class="text-uppercase fw-bold mb-3">
          Para estudiantes
        </h6>

        <ul class="list-unstyled">

          <li class="mb-2">

            <a
              href="/jobs"
              class="text-secondary text-decoration-none">

              <i class="fa-solid fa-magnifying-glass me-2"></i>
              Buscar ofertas

            </a>

          </li>

          <li class="mb-2">

            <a
              href="/jobs?type=internship"
              class="text-secondary text-decoration-none">

              <i class="fa-solid fa-graduation-cap me-2"></i>
              Prácticas profesionales

            </a>

          </li>

          <li class="mb-2">

            <a
              href="/jobs?remote=true"
              class="text-secondary text-decoration-none">

              <i class="fa-solid fa-house-laptop me-2"></i>
              Trabajo remoto

            </a>

          </li>

          <li class="mb-2">

            <a
              href="/register"
              class="text-secondary text-decoration-none">

              <i class="fa-solid fa-user-plus me-2"></i>
              Crear cuenta

            </a>

          </li>

        </ul>

      </div>


      <!-- =====================================================
           PARA EMPRESAS
      ====================================================== -->
      <div class="col-12 col-lg-3">

        <h6 class="text-uppercase fw-bold mb-3">
          Para empresas
        </h6>

        <p class="text-secondary small">
          Encuentra talento universitario y publica
          oportunidades laborales para estudiantes
          y recién egresados.
        </p>

        <a
          href="/register/company"
          class="btn btn-success btn-sm mb-3">

          <i class="fa-solid fa-building me-2"></i>
          Publicar una oferta

        </a>

        <div class="d-flex gap-2 mt-2">

          <a
            href="#"
            class="btn btn-outline-secondary btn-sm rounded-circle"
            aria-label="GitHub">

            <i class="fa-brands fa-github"></i>

          </a>

          <a
            href="#"
            class="btn btn-outline-secondary btn-sm rounded-circle"
            aria-label="LinkedIn">

            <i class="fa-brands fa-linkedin"></i>

          </a>

          <a
            href="#"
            class="btn btn-outline-secondary btn-sm rounded-circle"
            aria-label="Instagram">

            <i class="fa-brands fa-instagram"></i>

          </a>

        </div>

      </div>

    </div>


    <!-- =====================================================
         SEPARADOR
    ====================================================== -->

    <hr class="border-secondary my-4">


    <!-- =====================================================
         COPYRIGHT
    ====================================================== -->

    <div
      class="d-flex flex-column flex-md-row
             justify-content-between
             align-items-center">

      <p class="text-secondary small mb-2 mb-md-0">

        © <%= new Date().getFullYear() %>
        UniEmpleo.
        Todos los derechos reservados.

      </p>


      <div class="d-flex gap-3">

        <a
          href="/privacy"
          class="text-secondary small text-decoration-none">

          Política de privacidad

        </a>

        <a
          href="/terms"
          class="text-secondary small text-decoration-none">

          Términos y condiciones

        </a>

      </div>

    </div>

  </div>

</footer>