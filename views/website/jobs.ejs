<% layout("layouts/website") %>

<!-- ========================================================= HEADER ========================================================= --> <section class="bg-dark text-white py-5"> <div class="container py-4"> <div class="row align-items-center">
  <div class="col-lg-8">
    <span class="badge bg-success px-3 py-2 mb-3">
      <i class="bi bi-briefcase-fill me-2"></i>
      BOLSA DE TRABAJO
    </span>

    <h1 class="display-5 fw-bold mb-3">
      Encuentra tu próxima
      <span class="text-success">oportunidad</span>
    </h1>

    <p class="lead text-secondary mb-0">
      Explora ofertas de trabajo, prácticas profesionales
      y oportunidades para estudiantes y egresados.
    </p>
  </div>

  <div class="col-lg-4 text-lg-end mt-4 mt-lg-0">
    <div class="d-inline-flex align-items-center bg-success bg-opacity-10 border border-success rounded-4 p-4">

      <i class="bi bi-briefcase text-success fs-1 me-3"></i>

      <div class="text-start">
        <h5 class="mb-1">
          <%= typeof jobCount !== 'undefined' ? jobCount : (typeof jobs !== 'undefined' ? jobs.length : 0) %>
        </h5>

        <small class="text-secondary">
          oportunidades disponibles
        </small>
      </div>

    </div>
  </div>

</div>

</div> </section> <!-- ========================================================= BUSCADOR Y FILTROS ========================================================= --> <section class="bg-light py-4"> <div class="container">
<div class="card border-0 shadow-sm">
  <div class="card-body p-4">

    <form action="/jobs" method="GET">

      <div class="row g-3">

        <!-- BUSCAR -->
        <div class="col-12 col-lg-4">
          <label for="search" class="form-label fw-semibold">
            Buscar empleo
          </label>

          <div class="input-group">
            <span class="input-group-text bg-white">
              <i class="bi bi-search"></i>
            </span>

            <input
              id="search"
              type="text"
              class="form-control"
              name="search"
              value="<%= typeof search !== 'undefined' ? search : '' %>"
              placeholder="Ej. desarrollador, marketing, diseño..."
            >
          </div>
        </div>

        <!-- ÁREA -->
        <div class="col-12 col-md-6 col-lg-2">
          <label for="area" class="form-label fw-semibold">
            Área
          </label>

          <select id="area" name="area" class="form-select">
            <option value="">Todas</option>

            <option value="Tecnología"
              <%= typeof area !== 'undefined' && area === 'Tecnología' ? 'selected' : '' %>>
              Tecnología
            </option>

            <option value="Administración"
              <%= typeof area !== 'undefined' && area === 'Administración' ? 'selected' : '' %>>
              Administración
            </option>

            <option value="Marketing"
              <%= typeof area !== 'undefined' && area === 'Marketing' ? 'selected' : '' %>>
              Marketing
            </option>

            <option value="Finanzas"
              <%= typeof area !== 'undefined' && area === 'Finanzas' ? 'selected' : '' %>>
              Finanzas
            </option>

            <option value="Ingeniería"
              <%= typeof area !== 'undefined' && area === 'Ingeniería' ? 'selected' : '' %>>
              Ingeniería
            </option>

            <option value="Diseño"
              <%= typeof area !== 'undefined' && area === 'Diseño' ? 'selected' : '' %>>
              Diseño
            </option>
          </select>
        </div>

        <!-- MODALIDAD -->
        <div class="col-12 col-md-6 col-lg-2">
          <label for="modality" class="form-label fw-semibold">
            Modalidad
          </label>

          <select id="modality" name="modality" class="form-select">
            <option value="">Todas</option>

            <option value="Presencial"
              <%= typeof modality !== 'undefined' && modality === 'Presencial' ? 'selected' : '' %>>
              Presencial
            </option>

            <option value="Remoto"
              <%= typeof modality !== 'undefined' && modality === 'Remoto' ? 'selected' : '' %>>
              Remoto
            </option>

            <option value="Híbrido"
              <%= typeof modality !== 'undefined' && modality === 'Híbrido' ? 'selected' : '' %>>
              Híbrido
            </option>
          </select>
        </div>

        <!-- TIPO -->
        <div class="col-12 col-md-6 col-lg-2">
          <label for="type" class="form-label fw-semibold">
            Tipo de empleo
          </label>

          <select id="type" name="type" class="form-select">
            <option value="">Todos</option>

            <option value="Prácticas"
              <%= typeof type !== 'undefined' && type === 'Prácticas' ? 'selected' : '' %>>
              Prácticas
            </option>

            <option value="Medio tiempo"
              <%= typeof type !== 'undefined' && type === 'Medio tiempo' ? 'selected' : '' %>>
              Medio tiempo
            </option>

            <option value="Tiempo completo"
              <%= typeof type !== 'undefined' && type === 'Tiempo completo' ? 'selected' : '' %>>
              Tiempo completo
            </option>
          </select>
        </div>

        <!-- BOTÓN -->
        <div class="col-12 col-md-6 col-lg-2 d-flex align-items-end">
          <button type="submit" class="btn btn-success w-100">
            <i class="bi bi-search me-2"></i>
            Buscar
          </button>
        </div>

      </div>

    </form>

  </div>
</div>

</div> </section> <!-- ========================================================= RESULTADOS ========================================================= --> <section class="py-5"> <div class="container">
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">

  <div>
    <span class="text-success fw-bold text-uppercase">
      Oportunidades laborales
    </span>

    <h2 class="fw-bold mt-2 mb-1">
      Ofertas disponibles
    </h2>

    <p class="text-muted mb-0">

      <% if (typeof jobs !== 'undefined' && jobs.length > 0) { %>

        Mostrando
        <strong><%= jobs.length %></strong>
        oportunidades.

      <% } else { %>

        Encuentra una oportunidad que se adapte a tu perfil.

      <% } %>

    </p>
  </div>

  <!-- ORDENAR -->
  <div class="mt-3 mt-md-0">

    <form action="/jobs" method="GET">

      <input
        type="hidden"
        name="search"
        value="<%= typeof search !== 'undefined' ? search : '' %>"
      >

      <input
        type="hidden"
        name="area"
        value="<%= typeof area !== 'undefined' ? area : '' %>"
      >

      <input
        type="hidden"
        name="modality"
        value="<%= typeof modality !== 'undefined' ? modality : '' %>"
      >

      <input
        type="hidden"
        name="type"
        value="<%= typeof type !== 'undefined' ? type : '' %>"
      >

      <select
        class="form-select"
        name="sort"
        onchange="this.form.submit()"
      >

        <option
          value="recent"
          <%= typeof sort === 'undefined' || sort === 'recent' ? 'selected' : '' %>
        >
          Más recientes
        </option>

        <option
          value="salary"
          <%= typeof sort !== 'undefined' && sort === 'salary' ? 'selected' : '' %>
        >
          Mejor remuneradas
        </option>

        <option
          value="deadline"
          <%= typeof sort !== 'undefined' && sort === 'deadline' ? 'selected' : '' %>
        >
          Próximas a vencer
        </option>

      </select>

    </form>

  </div>

</div>

<!-- =====================================================
     LISTADO
====================================================== -->

<div class="row g-4">

  <% if (typeof jobs !== 'undefined' && Array.isArray(jobs) && jobs.length > 0) { %>

    <% jobs.forEach(job => { %>

      <div class="col-12">

        <div class="card border-0 shadow-sm h-100 job-card">

          <div class="card-body p-4">

            <div class="row align-items-center">

              <!-- ICONO -->
              <div class="col-auto">
                <div
                  class="rounded-3 bg-success bg-opacity-10 text-success d-flex align-items-center justify-content-center"
                  style="width:70px;height:70px;"
                >
                  <i class="bi bi-building fs-2"></i>
                </div>
              </div>

              <!-- INFORMACIÓN -->
              <div class="col">

                <div class="d-flex flex-column flex-md-row justify-content-between gap-3">

                  <div>

                    <div class="text-success small fw-semibold">
                      <i class="bi bi-building me-1"></i>
                      <%= job.company || 'Empresa' %>
                    </div>

                    <h4 class="fw-bold mb-2 mt-1">
                      <%= job.title || 'Puesto de trabajo' %>
                    </h4>

                  </div>

                  <% if (job.featured) { %>

                    <div>
                      <span class="badge bg-warning text-dark">
                        <i class="bi bi-star-fill me-1"></i>
                        Destacada
                      </span>
                    </div>

                  <% } %>

                </div>

                <!-- DATOS -->
                <div class="d-flex flex-wrap gap-3 text-muted small">

                  <% if (job.location) { %>
                    <span>
                      <i class="bi bi-geo-alt me-1 text-success"></i>
                      <%= job.location %>
                    </span>
                  <% } %>

                  <% if (job.modality) { %>
                    <span>
                      <i class="bi bi-laptop me-1 text-success"></i>
                      <%= job.modality %>
                    </span>
                  <% } %>

                  <% if (job.type) { %>
                    <span>
                      <i class="bi bi-clock me-1 text-success"></i>
                      <%= job.type %>
                    </span>
                  <% } %>

                  <% if (job.salary) { %>
                    <span class="text-success fw-semibold">
                      <i class="bi bi-cash-coin me-1"></i>
                      <%= job.salary %>
                    </span>
                  <% } %>

                </div>

                <!-- ETIQUETAS -->
                <div class="mt-3">

                  <% if (job.area) { %>
                    <span class="badge bg-light text-dark border me-1">
                      <i class="bi bi-tag me-1"></i>
                      <%= job.area %>
                    </span>
                  <% } %>

                  <% if (job.category) { %>
                    <span class="badge bg-light text-dark border me-1">
                      <%= job.category %>
                    </span>
                  <% } %>

                  <% if (job.experience) { %>
                    <span class="badge bg-light text-dark border me-1">
                      <i class="bi bi-person-check me-1"></i>
                      <%= job.experience %>
                    </span>
                  <% } %>

                </div>

              </div>

              <!-- BOTÓN -->
              <div class="col-12 col-lg-auto mt-3 mt-lg-0">

                <% if (job.id) { %>

                  <a
                    href="/jobs/<%= encodeURIComponent(job.id) %>"
                    class="btn btn-success w-100"
                  >
                    Ver oferta
                    <i class="bi bi-arrow-right ms-2"></i>
                  </a>

                <% } else { %>

                  <button
                    type="button"
                    class="btn btn-secondary w-100"
                    disabled
                  >
                    Oferta no disponible
                  </button>

                <% } %>

              </div>

            </div>

          </div>

        </div>

      </div>

    <% }) %>

  <% } else { %>

    <!-- =================================================
         SIN RESULTADOS
    ================================================== -->

    <div class="col-12">

      <div class="card border-0 shadow-sm">

        <div class="card-body text-center py-5">

          <div
            class="bg-success bg-opacity-10 text-success rounded-circle d-inline-flex align-items-center justify-content-center mb-4"
            style="width:90px;height:90px;"
          >
            <i class="bi bi-search fs-1"></i>
          </div>

          <h3 class="fw-bold">
            No encontramos ofertas
          </h3>

          <p class="text-muted mb-4">
            No existen oportunidades que coincidan
            con los filtros seleccionados.
          </p>

          <a
            href="/jobs"
            class="btn btn-outline-success"
          >
            <i class="bi bi-arrow-clockwise me-2"></i>
            Ver todas las ofertas
          </a>

        </div>

      </div>

    </div>

  <% } %>

</div>

<!-- =====================================================
     PAGINACIÓN
====================================================== -->

<% if (
  typeof totalPages !== 'undefined' &&
  Number(totalPages) > 1
) { %>

  <nav class="mt-5" aria-label="Paginación de ofertas">

    <ul class="pagination justify-content-center flex-wrap">

      <% for (let i = 1; i <= Number(totalPages); i++) { %>

        <li
          class="page-item <%= typeof currentPage !== 'undefined' && Number(currentPage) === i ? 'active' : '' %>"
        >

          <a
            class="page-link"
            href="/jobs?page=<%= i %>&search=<%= encodeURIComponent(typeof search !== 'undefined' ? search : '') %>&area=<%= encodeURIComponent(typeof area !== 'undefined' ? area : '') %>&modality=<%= encodeURIComponent(typeof modality !== 'undefined' ? modality : '') %>&type=<%= encodeURIComponent(typeof type !== 'undefined' ? type : '') %>&sort=<%= encodeURIComponent(typeof sort !== 'undefined' ? sort : 'recent') %>"
          >
            <%= i %>
          </a>

        </li>

      <% } %>

    </ul>

  </nav>

<% } %>

</div> </section> <!-- ========================================================= CTA EMPRESAS ========================================================= --> <section class="bg-light py-5"> <div class="container">
<div class="bg-dark rounded-4 p-5 text-center text-white">

  <div
    class="bg-success bg-opacity-10 text-success rounded-circle d-inline-flex align-items-center justify-content-center mb-3"
    style="width:75px;height:75px;"
  >
    <i class="bi bi-person-workspace fs-2"></i>
  </div>

  <h2 class="fw-bold">
    ¿Eres una empresa?
  </h2>

  <p class="text-secondary lead mb-4">
    Publica tus oportunidades y encuentra
    talento universitario.
  </p>

  <a
    href="/jobs/create"
    class="btn btn-success btn-lg px-4"
  >
    <i class="bi bi-plus-circle me-2"></i>
    Publicar oferta
  </a>

</div>

</div> </section> <!-- ========================================================= ESTILOS ========================================================= --> <style>
.job-card {
transition:
transform 0.2s ease,
box-shadow 0.2s ease;
}

.job-card:hover {
transform: translateY(-3px);
box-shadow: 0 0.75rem 1.5rem rgba(0, 0, 0, 0.10) !important;
}

.job-card .btn-success {
transition: all 0.2s ease;
}

.job-card .btn-success:hover {
transform: translateX(3px);
}

.pagination .page-link {
color: #198754;
}

.pagination .page-item.active .page-link {
background-color: #198754;
border-color: #198754;
}

@media (max-width: 767.98px) {
.job-card .card-body {
padding: 1.25rem !important;
}

.job-card .col-auto {
margin-bottom: 1rem;
}
}

</style>
