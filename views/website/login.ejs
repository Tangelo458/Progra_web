<% layout("layouts/access")%>
<!-- views\website\login.ejs -->


            <div class="col-12 col-sm-10 col-md-6 col-lg-5 col-xl-4">

                <div class="form bg-opacity-90 p-4 mt-5 rounded">

                    <!-- Logo -->
                    <div class="text-center mb-4">

                        <img
                            src="/assets/img/ulimaLogo.png"
                            height="50"
                            width="203"
                            alt="Logo Universidad de Lima"
                            class="img-fluid"
                        >

                    </div>

                    <div class="alert alert-danger d-none" role="alert" id="alertMessage">
                        A simple danger alert—check it out!
                    </div>

                    <!-- Formulario -->
                    <form>

                        <!-- Usuario -->
                        <div class="mb-3">

                            <label for="txtUser" class="form-label">
                                Usuario
                            </label>

                            <input
                                type="text"
                                class="form-control"
                                name="username"
                                id="txtUser"
                                placeholder="Nombre de usuario"
                            >

                        </div>

                        <!-- Contraseña -->
                        <div class="mb-3">

                            <label for="txtPassword" class="form-label">
                                Contraseña
                            </label>

                            <input
                                type="password"
                                class="form-control"
                                name="password"
                                id="txtPassword"
                                placeholder="Ingrese su contraseña"
                            >

                        </div>

                        <!-- Botón -->
                        <div class="d-grid mb-3">

                            <button
                                type="submit"
                                class="btn btn-dark" onclick="ingresar()" id="btnIngresar">
                                Iniciar sesión
                            </button>

                        </div>

                        <!-- Recuperar contraseña -->
                        <div class="text-center mb-4">

                            <a href="reset-password">
                                ¿Has olvidado tu contraseña?
                            </a>

                        </div>

                    </form>

                    <!-- Comunicado -->
                    <div class="bg-secondary bg-opacity-25 p-3 rounded">

                        <h3 class="text-center">
                            Comunicado
                        </h3>

                        <p class="mb-0">

                            Estimados usuarios de la comunidad ULima:<br><br>

                            Para resolver sus consultas sobre las plataformas
                            Blackboard y Zoom, ponemos a su disposición los
                            siguientes canales de atención:<br><br>

                            Correo electrónico: soporteaulas@ulima.edu.pe<br>
                            Teléfono: 01 437 8800<br>
                            Anexo (en campus): 500<br>
                            Presencial: Sótano Edificio L2.<br>
                            Horario: Lunes a viernes 7-22hrs,
                            Sábados 7-13hrs

                        </p>

                    </div>

                </div>

            </div>


<script>

    function ingresar() {

        // Evita que el formulario recargue la página
        event.preventDefault();

        let username = document.getElementById("txtUser").value; 
        console.log(username)

        let password = document.getElementById("txtPassword").value; 
        console.log(password)

        let alertMessage = document.getElementById('alertMessage');
        console.log(alertMessage)

        if(username=="" || password==""){
            alertMessage.classList.remove("d-none");
            alertMessage.classList.remove("alert-success");
            alertMessage.classList.add("alert-danger");
            alertMessage.innerHTML = "Oe llena los campos";
        }
        else{
            if(username=="admin" && password=="123"){
                alertMessage.classList.remove("d-none");
                alertMessage.innerHTML = "Bienvenido";
                alertMessage.classList.remove("alert-danger");
                alertMessage.classList.add("alert-success");

            document.getElementById("txtUser").disabled=true;
            document.getElementById("txtPassword").disabled=true;
            document.getElementById("btnIngresar").disabled=true;

            setInterval(() => {
            window.location.href= "/dashboard.html";
            },5000);
            
            
            }else{
                alertMessage.classList.remove("d-none");
                alertMessage.classList.add("alert-danger");
                alertMessage.classList.remove("alert-success");
                alertMessage.innerHTML = "Credenciales inválidas";   
            }
        }
    }

        document.addEventListener("DOMContentLoaded", function () {
            let fondos = [
            "/assets/img/fondo.png",
            "/assets/img/fondo2.png",
            "/assets/img/fondo3.jpg"
        ];


        setInterval(() => {
        let indice = Math.floor(Math.random() * 3);
        document.body.style.backgroundImage = `url('${fondos[indice]}')`;
    }, 5000);
});
</script>

</body>

</html>