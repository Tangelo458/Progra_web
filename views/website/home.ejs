        .service-card {
            border: none;
            border-radius: 15px;
            padding: 30px;
            height: 100%;
            transition: 0.3s;
        }

        .service-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 15px 30px rgba(0, 0, 0, 0.12);
        }

        .icon {
            width: 65px;
            height: 65px;

