<!-- views/website/home.ejs -->

<% layout("layouts/website") %>

<!-- =========================================================
     HERO
========================================================= -->

<section class="bg-dark text-white">

  <div
    id="heroCarousel"
    class="carousel slide carousel-fade"
    data-bs-ride="carousel"
    data-bs-interval="5000">

    <!-- Indicadores -->
    <div class="carousel-indicators">

      <button
        type="button"
        data-bs-target="#heroCarousel"
        data-bs-slide-to="0"
        class="active"
        aria-current="true"
        aria-label="Slide 1">
      </button>

      <button
        type="button"
        data-bs-target="#heroCarousel"
        data-bs-slide-to="1"
        aria-label="Slide 2">
      </button>

      <button
        type="button"
        data-bs-target="#heroCarousel"
        data-bs-slide-to="2"
        aria-label="Slide 3">
      </button>

    </div>


    <!-- =====================================================
         SLIDES
    ====================================================== -->

    <div class="carousel-inner">


      <!-- SLIDE 1 -->
      <div class="carousel-item active">

        <div
          class="container-fluid"
          style="
            min-height: 600px;
            background:
              linear-gradient(
                90deg,
                rgba(0,0,0,.90),
                rgba(0,0,0,.60),
                rgba(0,0,0,.30)
              ),
              url('/assets/img/slider-1.jpg')
              center/cover;
          ">

          <div
            class="container d-flex align-items-center"
            style="min-height: 600px;">

            <div class="row w-100">

              <div class="col-lg-7">

                <span class="badge bg-success mb-3 px-3 py-2">

                  <i class="bi bi-mortarboard-fill me-1"></i>

                  BOLSA DE TRABAJO UNIVERSITARIA

                </span>


                <h1 class="display-3 fw-bold mb-4">

                  Encuentra tu próxima
                  <span class="text-success">
                    oportunidad
                  </span>

                </h1>


                <p class="lead text-light mb-4">

                  Conecta con empresas, encuentra prácticas
                  profesionales y descubre oportunidades
                  laborales pensadas para estudiantes
                  universitarios.

                </p>


                <div class="d-flex flex-wrap gap-2">

                  <a
                    href="/jobs"
                    class="btn btn-success btn-lg px-4">

                    <i class="bi bi-search me-2"></i>

                    Buscar ofertas

                  </a>


                  <a
                    href="/register"
                    class="btn btn-outline-light btn-lg px-4">

                    <i class="bi bi-person-plus me-2"></i>

                    Crear perfil

                  </a>

                </div>

              </div>

            </div>

          </div>

        </div>

      </div>


      <!-- =====================================================
           SLIDE 2
      ====================================================== -->

      <div class="carousel-item">

        <div
          class="container-fluid"
          style="
            min-height: 600px;
            background:
              linear-gradient(
                90deg,
                rgba(0,0,0,.90),
                rgba(0,0,0,.60),
                rgba(0,0,0,.30)
              ),
              url('/assets/img/slider-2.jpg')
              center/cover;
          ">

          <div
            class="container d-flex align-items-center"
            style="min-height: 600px;">

            <div class="row w-100">

              <div class="col-lg-7">

                <span class="badge bg-success mb-3 px-3 py-2">

                  <i class="bi bi-briefcase-fill me-1"></i>

                  OPORTUNIDADES PROFESIONALES

                </span>


                <h2 class="display-4 fw-bold mb-4">

                  Da el siguiente paso
                  en tu
                  <span class="text-success">
                    carrera
                  </span>

                </h2>


                <p class="lead mb-4">

                  Encuentra ofertas de prácticas,
                  empleos de medio tiempo y oportunidades
                  para comenzar tu experiencia profesional.

                </p>


                <a
                  href="/jobs?type=internship"
                  class="btn btn-success btn-lg px-4">

                  <i class="bi bi-mortarboard me-2"></i>

                  Ver prácticas

                </a>

              </div>

            </div>

          </div>

        </div>

      </div>


      <!-- =====================================================
           SLIDE 3
      ====================================================== -->

      <div class="carousel-item">

        <div
          class="container-fluid"
          style="
            min-height: 600px;
            background:
              linear-gradient(
                90deg,
                rgba(0,0,0,.90),
                rgba(0,0,0,.60),
                rgba(0,0,0,.30)
              ),
              url('/assets/img/slider-3.jpg')
              center/cover;
          ">

          <div
            class="container d-flex align-items-center"
            style="min-height: 600px;">

            <div class="row w-100">

              <div class="col-lg-7">

                <span class="badge bg-success mb-3 px-3 py-2">

                  <i class="bi bi-building me-1"></i>

                  CONECTA CON EMPRESAS

                </span>


                <h2 class="display-4 fw-bold mb-4">

                  Las empresas están
                  buscando
                  <span class="text-success">
                    talento
                  </span>

                </h2>


                <p class="lead mb-4">

                  Crea tu perfil profesional y permite
                  que las empresas encuentren tus
                  habilidades y experiencia.

                </p>


                <a
                  href="/register"
                  class="btn btn-success btn-lg px-4">

                  <i class="bi bi-person-plus me-2"></i>

                  Crear mi perfil

                </a>

              </div>

            </div>

          </div>

        </div>

      </div>

    </div>


    <!-- Controles -->

    <button
      class="carousel-control-prev"
      type="button"
      data-bs-target="#heroCarousel"
      data-bs-slide="prev">

      <span class="carousel-control-prev-icon"></span>

      <span class="visually-hidden">
        Anterior
      </span>

    </button>


    <button
      class="carousel-control-next"
      type="button"
      data-bs-target="#heroCarousel"
      data-bs-slide="next">

      <span class="carousel-control-next-icon"></span>

      <span class="visually-hidden">
        Siguiente
      </span>

    </button>

  </div>

</section>



<!-- =========================================================
     BUSCADOR DE OFERTAS
========================================================= -->

<section class="bg-light py-5">

  <div class="container">

    <div class="text-center mb-4">

      <span class="text-success fw-bold text-uppercase">

        Encuentra oportunidades

      </span>


      <h2 class="fw-bold mt-2">

        ¿Qué estás buscando?

      </h2>


      <p class="text-muted">

        Busca ofertas laborales según tu carrera,
        modalidad o tipo de empleo.

      </p>

    </div>


    <div class="card border-0 shadow-sm">

      <div class="card-body p-4">

        <form
          action="/jobs"
          method="GET">

          <div class="row g-3">


            <!-- Buscar -->

            <div class="col-12 col-lg-5">

              <label class="form-label fw-semibold">

                Palabras clave

              </label>


              <div class="input-group">

                <span class="input-group-text bg-white">

                  <i class="bi bi-search"></i>

                </span>


                <input
                  type="text"
                  class="form-control"
                  name="search"
                  placeholder="Ej. desarrollador, marketing, diseño...">

              </div>

            </div>


            <!-- Tipo -->

            <div class="col-12 col-md-6 col-lg-3">

              <label class="form-label fw-semibold">

                Tipo de oportunidad

              </label>


              <select
                name="type"
                class="form-select">

                <option value="">
                  Todas
                </option>

                <option value="internship">
                  Prácticas profesionales
                </option>

                <option value="part-time">
                  Medio tiempo
                </option>

                <option value="full-time">
                  Tiempo completo
                </option>

                <option value="freelance">
                  Freelance
                </option>

              </select>

            </div>


            <!-- Modalidad -->

            <div class="col-12 col-md-6 col-lg-2">

              <label class="form-label fw-semibold">

                Modalidad

              </label>


              <select
                name="remote"
                class="form-select">

                <option value="">
                  Todas
                </option>

                <option value="false">
                  Presencial
                </option>

                <option value="true">
                  Remoto
                </option>

                <option value="hybrid">
                  Híbrido
                </option>

              </select>

            </div>


            <!-- Botón -->

            <div class="col-12 col-lg-2 d-flex align-items-end">

              <button
                type="submit"
                class="btn btn-success w-100">

                <i class="bi bi-search me-2"></i>

                Buscar

              </button>

            </div>

          </div>

        </form>

      </div>

    </div>

  </div>

</section>



